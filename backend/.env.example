MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=feedy
DEFAULT_COMPANY_ID=demo-co

LLM_PROVIDER_ORDER=huggingface,groq,gemini
MAX_NEW_TOKENS=2000

USE_LOCAL_LLM=false

HF_TOKEN=hf_your_token_here
HF_REPO_ID=Qwen/Qwen2.5-7B-Instruct
HF_LOCAL_MODEL=Qwen/Qwen2.5-1.5B-Instruct

GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=your_google_ai_studio_key_here
GEMINI_MODEL=gemini-2.5-flash

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

PINECONE_API_KEY=your_pinecone_key_here
PINECONE_INDEX_NAME=feedy-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

LABELLED_NAMESPACE=labelled
KNOWLEDGE_NAMESPACE=knowledge

LOCAL_VECTOR_PATH=data/local_vectors.npz

TESSERACT_CMD=
OCR_DPI=300
ENABLE_VISION_OCR=false

REVIEW_THRESHOLD=0.60
ALERT_THRESHOLD=0.80

MAX_RECORDS_PER_UPLOAD=60
LLM_CONCURRENCY=4
RETRIEVAL_K=5

CORS_ORIGINS=http://localhost:5173